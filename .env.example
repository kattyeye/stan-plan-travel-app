# ── Required ────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=            # Claude API key
PLAN_UPSTASH_KV_REST_API_URL= # Upstash Redis (UPSTASH_REDIS_REST_URL also works)
PLAN_UPSTASH_KV_REST_API_TOKEN=
NEXT_PUBLIC_APP_URL=          # e.g. https://stan-plan-travel-app.vercel.app (links in emails)
ADMIN_EMAILS=                 # your email(s), comma-separated: sign in at /login to open /admin
AUTH_SECRET=                  # signs sign-in sessions: `openssl rand -hex 32` (derived from other keys if unset)
ADMIN_TOKEN=                  # optional long random string for scripts calling /api/admin/* (Bearer token)

# ── Strongly recommended ───────────────────────────────────────────────────
GOOGLE_MAPS_API_KEY=          # SERVER key with "Places API (New)" enabled — confirms venues are open
                              # and supplies real opening hours. Without it, venues are web-sourced only.
STRIPE_SECRET_KEY=            # sk_test_… to try it, sk_live_… to take real money. Without it only free plans exist.
STRIPE_WEBHOOK_SECRET=        # endpoint: /api/stripe/webhook, events: checkout.session.completed,
                              # checkout.session.async_payment_succeeded
STRIPE_AUTOMATIC_TAX=         # "true" once Stripe Tax is set up in the dashboard (otherwise Checkout errors)
RESEND_API_KEY=               # sign-in links and "your plan is ready" emails (required for sign-in in production)
EMAIL_FROM="Irie <trips@yourdomain.com>"  # an address on a domain verified in Resend

# ── Optional ───────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=  # browser key: day route maps on the trip page. Enable "Maps Embed API" (free, unlimited) and
                                  # restrict it to your site's referrer. Without it, days show "Open in Google Maps" links instead.
NEXT_PUBLIC_UNSPLASH_ACCESS_KEY=  # hero photos
TRIP_PRICE_CENTS=1900
IRIE_FREE_FIRST_PLAN=true         # first plan per email is free; "false" to turn off
IRIE_FREE_PER_IP_PER_DAY=2        # free plans per network per day
IRIE_FREE_DAILY_CAP=25            # free plans site-wide per day (caps free spend)
IRIE_BETA_DAILY_LIMIT=10          # beta testers' free plans per tester per day (safety cap)
IRIE_DEV_LOGIN_LINKS=             # "true" shows sign-in links on screen when RESEND_API_KEY is unset (never in real production)
IRIE_AUTOCOMPLETE_PROVIDER=photon # destination search: photon (free, OpenStreetMap) or google (billed)
IRIE_MODEL=claude-opus-5-5        # research / planning / recipes
IRIE_FAST_MODEL=claude-haiku-5-5  # wizard suggestions
IRIE_RESEARCH_EFFORT=medium       # low | medium | high | xhigh | max
IRIE_PLAN_EFFORT=medium
IRIE_RECIPES_EFFORT=low
IRIE_PACKING_EFFORT=low
IRIE_MAX_SEARCHES=12              # web searches per trip
INTERNAL_API_SECRET=              # stage hand-off auth; derived from ANTHROPIC_API_KEY if unset
VERCEL_AUTOMATION_BYPASS_SECRET=  # only if Vercel deployment protection is on for previews

# Local development without API credits:
#   npm run dev:mock   (in one terminal)
#   ANTHROPIC_BASE_URL=http://127.0.0.1:4010 ANTHROPIC_API_KEY=mock ADMIN_EMAILS=you@example.com npm run dev
#   (without RESEND_API_KEY, /login shows the sign-in link on screen in development)
